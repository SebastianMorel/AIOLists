# Docker Compose Environment Configuration
# Copy this file to .env and configure as needed

# TMDB Configuration (optional - can be set via AIOLists UI if not provided here)
TMDB_REDIRECT_URI=
TMDB_BEARER_TOKEN=

# Redis Configuration (optional - defaults to the redis container if not provided)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Advanced Redis Configuration (if using external Redis instead of the included container)
# REDIS_HOST=your-external-redis-host
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password